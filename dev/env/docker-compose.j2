#jinja2: trim_blocks:False

---

volumes:
  uploads:
  vendor:
  vendor-public:
  composer-cache:

services:
  cache:
    container_name: cache
    image: memcached:1.6.10
{% if use_arch != 'pi' %}
    platform: linux/x86_64
{% endif %}
    ports:
      - 11211:11211
  app:
    container_name: app
{% if use_arch != 'pi' %}
    platform: linux/x86_64
{% endif %}
    image: registry.gitlab.com/mikejw/empathy/franken-dev-wnode:{% if use_arch == 'pi' %}arm64{% else %}latest{% endif +%}
    environment:
      - VIRTUAL_HOST={{ use_host }}
      - VIRTUAL_PORT=80
      - COMPOSER_CACHE_DIR=/tmp/composer  
    volumes:
      - {{ code_dir }}/{{ use_project }}:/var/www/project
      - /etc/localtime:/etc/localtime:ro
      - uploads:/var/www/project/public_html/uploads
      - vendor:/var/www/project/vendor
      - vendor-public:/var/www/project/public_html/vendor
      - composer-cache:/tmp/composer
    user: "${UID}:${GID}"  

  # TODO: add log rotation
  app-log:
    container_name: app-log
    platform: linux/x86_64
    image: alpine:latest
    volumes:
      - {{ code_dir }}/{{ use_project }}/logs/main.log:/home/main.log
    command: tail -f /home/main.log
        
  db:
    container_name: db
{% if use_arch != 'pi' %}
    platform: linux/x86_64
{% endif %}
    image: mysql:8.4.4
    volumes:
      - "./db/log:/var/log/mysql"
      #- "./db/default.cnf:/etc/mysql/conf.d/default.cnf"
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped
    environment:
      - MYSQL_ROOT_PASSWORD=example
      - MYSQL_DATABASE=project
    ports:
      - 3306:3306


{{ partial_text }}


# if using 'global' nginx proxy setup
# this container is not required
# and specify (uncomment) the network settings below
  proxy:
    image: jwilder/nginx-proxy
    container_name: proxy
    ports:
      - 80:80
    volumes:
      - /var/run/docker.sock:/tmp/docker.sock:ro
      - ./env/vhost.d:/etc/nginx/vhost.d

